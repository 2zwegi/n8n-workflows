    {
      "parameters": {
        "promptType": "define",
        "text": "=Vous êtes un assistant de filtrage intelligent pour un système de support client.\n\nVotre rôle:\n1. Analyser le message du client: {{ $json.message }}\n2. Déterminer quel agent est le plus approprié selon ces critères:\n   - Agent 1: Questions techniques, bugs, problèmes de compte\n   - Agent 2: Questions commerciales, ventes, tarification  \n   - Agent 3: Support général, onboarding, formation\n\n3. Répondre UNIQUEMENT avec un JSON dans ce format:\n{\n  \"assigned_agent\": \"Agent 1\" ou \"Agent 2\" ou \"Agent 3\",\n  \"reason\": \"Explication courte\",\n  \"confidence\": \"high\" ou \"medium\" ou \"low\"\n}\n\nNom du client: {{ $json.first_name }} {{ $json.last_name }}\nMessage: {{ $json.message }}\n\nRépondez maintenant:",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Tu es un agent de filtrage. Tu réponds UNIQUEMENT en JSON valide, sans texte avant ou après."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1440,
        400
      ],
      "id": "c340ebd4-d6f0-417b-8fef-3588911322f8",
      "name": "AI Filtering Agent"
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/{{ $json.body.entry[0].messaging[0].sender.id }}?fields=first_name,last_name&access_token=YOUR_PAGE_ACCESS_TOKEN",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        16,
        240
      ],
      "id": "94376ee5-afdb-4724-9cbe-ba00dd132d48",
      "name": "Get User Info"
    },
    {
      "parameters": {
        "jsCode": "// Check if message is from user (not echo)\nconst messaging = $input.item.json.body?.entry?.[0]?.messaging?.[0];\n\n// If no message or is echo, stop execution\nif (!messaging?.message || messaging.message.is_echo) {\n  return [];\n}\n\n// Otherwise, pass the data through\nreturn [$input.item];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        240
      ],
      "id": "73697889-2b88-40a0-85ef-36b651973178",
      "name": "Filter Echo Messages"
    },
