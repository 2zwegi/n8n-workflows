    {
      "parameters": {
        "jsCode": "// نجيب كل الـ tracking data\nconst allTracking = $('Save to Tracking Sheet').all();\nconst chatId = $('Workflow Configuration1').first().json.chatId;\n\nlet totalSent = 0;\nlet totalFailed = 0;\nconst failedNames = [];\n\nallTracking.forEach(item => {\n  if (item.json.status === 'Sent') {\n    totalSent++;\n  } else {\n    totalFailed++;\n    failedNames.push(item.json.name);\n  }\n});\n\nconst total = totalSent + totalFailed;\nconst successRate = ((totalSent / total) * 100).toFixed(1);\n\nlet message = '✅ اكتمل الإرسال!\\n\\n';\nmessage += '📊 الإحصائيات:\\n';\nmessage += '━━━━━━━━━━━━━━━\\n';\nmessage += '📤 إجمالي: ' + total + '\\n';\nmessage += '✅ نجحت: ' + totalSent + '\\n';\nmessage += '❌ فشلت: ' + totalFailed + '\\n';\nmessage += '📈 معدل النجاح: ' + successRate + '%\\n';\n\nif (totalFailed > 0) {\n  message += '\\n⚠️ الفاشلة:\\n' + failedNames.join(', ');\n}\n\nreturn [{\n  json: {\n    message: message,\n    chatId: chatId,\n    stats: {\n      total: total,\n      sent: totalSent,\n      failed: totalFailed,\n      successRate: successRate\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
