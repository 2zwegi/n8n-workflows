{
  "name": "WhatsApp Bulk Sender with Delivery Tracking",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const chatId = $('Workflow Configuration1').first().json.chatId;\nconst pendingData = $('Read Pending Message1').all();\nconst userMessage = pendingData[pendingData.length - 1].json.userMessage;\nconst contacts = $('Read Contact List1').all();\nconst results = [];\nconst timestamp = new Date().toISOString();\n\nfor (let i = 0; i < contacts.length; i++) {\n  const contact = contacts[i];\n  const name = contact.json.nom;\n  let phone = contact.json.numero.toString();\n  phone = phone.replace(/\\D/g, '');\n  if (!phone.startsWith('216')) {\n    phone = '216' + phone;\n  }\n  \n  const personalizedMessage = userMessage\n    .replace(/\\{\\{name\\}\\}/g, name)\n    .replace(/\\{\\{date\\}\\}/g, new Date().toLocaleDateString('ar-TN'))\n    .replace(/\\{\\{time\\}\\}/g, new Date().toLocaleTimeString('ar-TN'));\n  \n  // نضيف ID فريد لكل رسالة\n  const messageId = timestamp + '_' + phone;\n  \n  results.push({\n    json: {\n      messageId: messageId,\n      name: name,\n      phone: phone,\n      message: personalizedMessage,\n      chatId: phone + '@c.us',\n      timestamp: timestamp\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -176,
        4064
      ],
      "id": "1cbbfcbc-1c28-4c76-8cb6-f255ffc2d4fe",
      "name": "Code - Prepare Messages"
    },
    {
      "parameters": {
        "jsCode": "// نجيب البيانات من الـ input\nconst input = $input.item.json;\nconst whatsappResponse = input;\n\n// نجيب البيانات الأصلية من Code - Prepare Messages\nconst originalData = $('Code - Prepare Messages').item.json;\n\n// نحدد الـ status بناءً على response\nlet status = 'Failed';\nlet errorMsg = '';\n\nif (whatsappResponse && !whatsappResponse.error) {\n  status = 'Sent';\n} else {\n  errorMsg = whatsappResponse.error || 'Unknown error';\n}\n\nreturn [{\n  json: {\n    messageId: originalData.messageId,\n    timestamp: new Date().toISOString(),\n    name: originalData.name,\n    phone: originalData.phone,\n    message: originalData.message,\n    status: status,\n    sentAt: new Date().toLocaleString('ar-TN'),\n    delivered: '',\n    read: '',\n    readAt: '',\n    errorMessage: errorMsg\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
