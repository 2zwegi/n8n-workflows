    {
      "parameters": {
        "jsCode": "// نجيب البيانات من الـ webhook\nconst webhookData = $input.item.json;\n\nconsole.log('Webhook received:', JSON.stringify(webhookData.body));\n\nconst eventType = webhookData.body?.event;\n\nif (!eventType || !eventType.includes('message')) {\n  console.log('Skipping non-message event:', eventType);\n  return [];\n}\n\nconst payload = webhookData.body?.payload || {};\nconst messageId = payload.id || payload.messageId;\nconst ack = payload.ack;\n\n// نستخرج الـ phone من الـ messageId\n// مثال: \"true_216XXXXXXXX@c.us_...\"\nlet phone = '';\nconst match = messageId.match(/(\\d{12,})/); // نجيب أول رقم طويل\nif (match) {\n  phone = match[1];\n}\n\nlet status = '';\nif (ack === 2) status = 'delivered';\nif (ack === 3) status = 'read';\n\nif (!messageId || !status) {\n  console.log('Missing messageId or status, skipping');\n  return [];\n}\n\nreturn [{\n  json: {\n    messageId: messageId,\n    phone: phone,\n    status: status,\n    timestamp: new Date().toISOString(),\n    readAt: status === 'read' ? new Date().toLocaleString('ar-TN') : '',\n    ack: ack\n  }\n}];"
      },
