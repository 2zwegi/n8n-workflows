        "jsCode": "const userMessage = $('Workflow Configuration1').item.json.userMessage;\nconst chatId = $('Workflow Configuration1').item.json.chatId;\nconst contacts = $('Read Contact List1').all();\n\nif (userMessage.trim().toLowerCase() === 'ok') {\n  return [{\n    json: {\n      type: 'send',\n      chatId: chatId\n    }\n  }];\n}\n\nconst names = contacts.map(c => c.json.nom).join(', ');\nconst count = contacts.length;\n\nreturn [{\n  json: {\n    type: 'confirm',\n    message: '📝 الرسالة:\\n\\n\"' + userMessage + '\"\\n\\n👥 للـ contacts (' + count + '):\\n' + names + '\\n\\n✅ اكتب \"ok\" للإرسال',\n    chatId: chatId,\n    userMessage: userMessage\n  }\n}];"
